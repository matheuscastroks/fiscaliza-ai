# URL acessível pelo dispositivo; localhost no celular é o próprio celular.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# O botão de conta de testes já aparece em desenvolvimento. Habilite em builds de teste.
EXPO_PUBLIC_ENABLE_TEST_LOGIN=false
# Chave pública do Mapbox (pk.eyJ...) para renderização vetorial do mapa.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_API_MAPBOX=
# Credenciais do Gemini ficam apenas em backend/.env (GEMINI_API_KEY).
