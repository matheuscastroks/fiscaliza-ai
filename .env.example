# ==============================================================================
# FISCALIZA AI - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para um novo arquivo chamado .env:
#    cp .env.example .env (ou copie manualmente)
# 2. Preencha os valores abaixo com as suas credenciais.
#
# Importante: No Expo, variáveis acessadas pelo cliente precisam
# conter o prefixo EXPO_PUBLIC_ para serem embutidas no bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# GOOGLE MAPS
# ------------------------------------------------------------------------------
# Chave de API do Google Maps (utilizada pelo react-native-maps no Android/iOS/Web).
# Necessita das seguintes APIs habilitadas no Google Cloud Console:
# - Maps SDK for Android
# - Maps SDK for iOS
# - Maps JavaScript API (se for rodar no Web)
# - Geocoding API (opcional, para converter endereço em coordenadas)
# Obtenha em: https://console.cloud.google.com/google/maps-apis
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
# Chave da API do Google Gemini para classificação e análise automática de fotos de denúncias.
# Obtenha em: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=sua_chave_gemini_aqui

# Mantido para retrocompatibilidade com scripts/código legados:
GEMINI_KEY=sua_chave_gemini_aqui

# ------------------------------------------------------------------------------
# SERVIÇOS DE BACKEND / API (Opcional / Futuro)
# ------------------------------------------------------------------------------
# URL base do servidor de API backend (quando não estiver utilizando o mock local do AsyncStorage).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
