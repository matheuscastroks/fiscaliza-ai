POSTGRES_PASSWORD=troque-a-senha-do-banco
NODE_ENV=development
WEB_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8081,http://localhost:8082
# Modo público: veja compose.public.yaml e deploy/README.md. Mantenha 127.0.0.1.
API_BIND=127.0.0.1
# Porta da API no host. 43001 evita conflito com outros serviços de desenvolvimento na 3001.
API_PORT=43001
WEB_BIND=127.0.0.1
PUBLIC_DOMAIN=localhost

CLOUDFLARE_TUNNEL_TOKEN=

# Modo público: backup, sincronização agendada e monitores (veja deploy/README.md)
BACKUP_DIR=./backups
BIGQUERY_CREDENTIALS_FILE=./secrets/bigquery.json
GCP_PROJECT_ID=
HEALTHCHECK_SYNC_URL=
HEALTHCHECK_BACKUP_URL=

# Registro de erros da API e do agendador (projeto Node no Sentry). Vazio: nada é enviado.
SENTRY_DSN=
