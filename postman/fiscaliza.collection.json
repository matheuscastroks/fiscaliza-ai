    {
      "name": "Cadastro de conta",
      "description": "Executar apenas em banco isolado de validação: cria duas sessões e uma conta cidadã.",
      "item": [
        {
          "name": "Criar conta cidadã",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Fiscaliza-Client",
                "value": "citizen"
              },
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nova pessoa\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registrationEmail', 'cadastro-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');",
                  "pm.collectionVariables.set('registrationPassword', 'Cadastro-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Envelope coerente', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const data = pm.response.json().data;",
                  "pm.test('Conta cidadã sem município arbitrário', () => { pm.expect(data.user.role).to.eql('citizen'); pm.expect(data.user.municipality).to.eql(null); pm.expect(data.user).not.to.have.property('passwordHash'); });",
                  "pm.test('Sessão iniciada', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('registrationToken', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sessão do cadastro",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Fiscaliza-Client",
                "value": "citizen"
              },
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{registrationToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Envelope coerente', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Conta criada está autenticada', () => pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('registrationEmail')));"
                ]
              }
            }
          ]
        },
