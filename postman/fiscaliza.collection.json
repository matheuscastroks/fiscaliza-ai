{
  "info": {
    "name": "Fiscaliza aí — autenticação e dados oficiais",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Validação de autenticação e perfil. Não cria ocorrências ou contribuições. Endpoints públicos oficiais podem ser consultados sem sessão."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:43001/api"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "webOrigin",
      "value": "http://localhost:5173"
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Entrar cidadão",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{webOrigin}}"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP esperado', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Envelope coerente', () => pm.expect(result.success).to.eql(200 < 400));",
              "pm.collectionVariables.set('citizenToken', result.data.token);",
              "pm.test('Conta possui retrato de apresentação', () => pm.expect(pm.response.json().data.user.avatar).to.match(/^\\/api\\/demo-media\\/avatar-/));"
            ]
          }
        }
      ]
    },
