{
  "name": "fiscaliza-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "npm run build && node dist/back/src/server.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/require-test-db.mjs && npm run build && node --test --test-concurrency=1 dist/back/test/*.test.js",
    "migrate": "npm run build && node dist/back/src/migrate.js",
    "openapi": "npm run build && node dist/back/src/openapi.js",
    "sync:rio1746": "npm run build && node dist/back/src/sync-cli.js",
    "probe:siurb": "npm run build && node dist/back/src/integrations/siurb/probe.js",
    "sync:siurb": "npm run build && node dist/back/src/siurb-cli.js",
    "lint": "cd .. && node back/node_modules/eslint/bin/eslint.js back/src back/test shared --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@google-cloud/bigquery": "^9.6.1",
    "@sentry/node": "^10.78.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
