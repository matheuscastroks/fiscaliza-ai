DATABASE_URL=postgres://fiscaliza:fiscaliza-local@localhost:5432/fiscaliza
PORT=3001
WEB_ORIGINS=http://localhost:5173,http://localhost:8081
UPLOAD_DIR=uploads
# Apenas testes locais: endpoint controlado pelo operador; nunca recebido do cliente.
# IPs/CIDRs dos proxies confiáveis; vazio para acesso direto.
TRUST_PROXY=
# Orçamento máximo em bytes faturados para toda a execução 1746 (páginas e datas).
RIO1746_MAX_RUN_BYTES=500000000
# Projeto explícito; autenticação por ADC/GOOGLE_APPLICATION_CREDENTIALS.
GCP_PROJECT_ID=

# Análise de foto no Agir (Gemini, só no servidor). Vazio: a análise fica desligada.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Teto diário de análises (na memória da API; reinício zera).
GEMINI_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT_PER_USER=20
