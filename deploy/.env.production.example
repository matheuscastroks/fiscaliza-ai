# Copy to /opt/fiscaliza-ai/.env.production on the VPS; never commit real values.
PUBLIC_DOMAIN=fiscalizaai.matheuscastroks.com.br
# Existing remotely managed tunnel route: this hostname -> http://api:3001.
# Copy the connector token securely to this VPS-only file; never to GitHub source.
CLOUDFLARE_TUNNEL_TOKEN=SUBSTITUA_PELO_TOKEN_DO_TUNEL
# Use hex strings (openssl rand -hex 32); URL punctuation needs encoding in DATABASE_URL.
POSTGRES_PASSWORD=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
RIO1746_MAX_RUN_BYTES=500000000
GCP_PROJECT_ID=
# Sincronização agendada e backup (veja deploy/README.md)
BIGQUERY_CREDENTIALS_FILE=/opt/fiscaliza-ai/secrets/bigquery.json
BACKUP_DIR=/opt/fiscaliza-ai/backups
HEALTHCHECK_SYNC_URL=
HEALTHCHECK_BACKUP_URL=

# Registro de erros da API e do agendador (projeto Node no Sentry). Vazio: nada é enviado.
SENTRY_DSN=
