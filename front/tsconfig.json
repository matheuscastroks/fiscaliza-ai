{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/shared/*": [
        "../shared/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "tests/**/*.test.ts",
    "tests/components/**",
    "dist/**",
    "web-dist/**",
    "android/**",
    "ios/**",
    ".agents/**",
    ".impeccable/**"
  ]
}
