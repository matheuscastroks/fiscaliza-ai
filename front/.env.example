# URL acessível pelo dispositivo; localhost no celular é o próprio celular.
EXPO_PUBLIC_API_URL=http://localhost:43001/api
# Chave pública do Mapbox (pk.eyJ...) para renderização vetorial do mapa.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Local performance diagnostics only. Leave disabled for normal builds.
EXPO_PUBLIC_MAP_PERF=0
# baseline | visible-surface | unfrozen | retained-map
EXPO_PUBLIC_MAP_PERF_VARIANT=baseline

# Registro de erros (Sentry). Sem DSN, nada é enviado. Em desenvolvimento, só
# envia com EXPO_PUBLIC_SENTRY_DEV=1. O envio de source maps no EAS usa o secret
# SENTRY_AUTH_TOKEN (não coloque o token aqui).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEV=0
