{
  "expo": {
    "name": "Fiscaliza aí",
    "slug": "fiscaliza-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fiscalizaai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.anonymous.fiscalizaai"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F3F7F8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F8",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B1316"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa suas fotos para permitir anexar imagens como evidência da ocorrência relatada."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo utiliza sua localização para encontrar chamados do 1746 no entorno escolhido."
        }
      ],
      [
        "@rnmapbox/maps"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F52BA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
